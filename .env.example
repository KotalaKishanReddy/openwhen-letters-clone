# Copy this to .env.local and fill in your values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin credentials — set once, stored as bcrypt hash in DB
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=   # generate with: node -e "const b=require('bcryptjs');console.log(b.hashSync('yourpassword',12))"

# JWT secret for admin session tokens (random 64-char string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
