# ─────────────────────────────────────────────────────────────────────────────
# openwhen-letters — Environment Variables
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these in Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # NEVER expose to browser

# ── JWT — Admin session tokens ────────────────────────────────────────────────
# Must be at least 32 characters. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-96-char-random-hex-string

# ── Encryption — Letter content at rest ──────────────────────────────────────
# Must be EXACTLY 64 hex characters (= 32 bytes). SEPARATE from JWT_SECRET.
# Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: Changing this key makes all existing encrypted letters unreadable.
ENCRYPTION_KEY=replace-with-64-char-hex-string

# ── One-time Admin Setup ──────────────────────────────────────────────────────
# Required to call POST /api/admin/setup
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETUP_SECRET=replace-with-random-secret

# After running setup, set this to true and redeploy to permanently disable the endpoint
SETUP_DISABLED=false
